---
/** Inline search: sits among the filters, then docks flush below the sticky navbar
 *  (top-hub-nav) once scrolled past. SearchPopover keeps its own pill shape. */
import SearchPopover from './SearchPopover.vue';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { getProfileCache, getCreatorsList, type SerializedTemplate } from '../../lib/hub-api';
import { buildDiscoveryData } from '../../lib/search-discovery';

interface Props {
  templates: SerializedTemplate[];
  locale: string;
}

const { templates, locale } = Astro.props;
const creators = getCreatorsList(await getProfileCache());
const searchLabels = {
  placeholder: t('search.placeholder', locale as Locale),
  placeholderShort: t('search.placeholderShort', locale as Locale),
  ariaLabel: t('search.ariaLabel', locale as Locale),
};
// Precompute the small discovery slices server-side; the island lazy-loads the
// full catalog from grid.json only when a filter badge is applied.
const discovery = buildDiscoveryData(templates, creators);
---

<div class="sticky top-hub-nav z-40 bg-page pt-2 pb-6 lg:pb-8">
  <SearchPopover
    client:load
    popular={discovery.popular}
    creators={discovery.creators}
    facets={discovery.facets}
    totalCount={discovery.totalCount}
    locale={locale}
    labels={searchLabels}
  />
</div>
