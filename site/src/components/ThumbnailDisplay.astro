---
/**
 * ThumbnailDisplay - Renders template thumbnails with proper variants
 *
 * Supports:
 * - Video playback for webp animations (autoplay on hover)
 * - compareSlider: Before/after comparison slider (needs 2 thumbnails)
 * - hoverDissolve: Fades to 2nd image on hover
 * - zoomHover: Enhanced zoom on hover
 * - Default: Simple zoom on hover
 */

import type { ThumbnailVariant } from '../lib/hub-api';
import { getStillImageUrl, getVideoFrameUrl } from '../lib/video-thumbnail';
import {
  HERO_STILL_WIDTH,
  heroPaintsAnimatedStill,
  hubAssetUrl,
  hubMediaFor,
} from '../lib/hub-media';
import { isVideoFile, isAudioFile } from '../lib/media-utils';

interface Props {
  thumbnails: string[];
  title: string;
  variant?: ThumbnailVariant;
  mediaSubtype?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  naturalAspect?: boolean;
}

const {
  thumbnails,
  title,
  variant,
  mediaSubtype,
  class: className = '',
  loading = 'lazy',
  fetchpriority,
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 640px',
  naturalAspect = false,
} = Astro.props;

// If thumbnail is already a full URL, use it directly; otherwise prepend local path
function thumbUrl(thumb: string): string {
  if (thumb.startsWith('http://') || thumb.startsWith('https://')) return thumb;
  return `/workflows/thumbnails/${thumb}`;
}

const mediaClass = naturalAspect ? 'w-full h-auto' : 'w-full h-full object-cover';
const imgClass = mediaClass;

const primaryThumb = thumbnails[0];
const secondaryThumb = thumbnails[1];
// This is the hero of every workflow detail page, the worst-LCP page type in
// the baseline at 15.9 s. Resolve to our re-encoded copy where one exists;
// anything newer than the last generation run keeps its original URL.
const primaryOriginal = primaryThumb ? thumbUrl(primaryThumb) : '';
const secondaryOriginal = secondaryThumb ? thumbUrl(secondaryThumb) : '';
const primarySrc = hubAssetUrl(primaryOriginal);
const secondarySrc = hubAssetUrl(secondaryOriginal);
const isAnimated = mediaSubtype === 'webp';
/**
 * An eagerly-loaded animated WebP is the worst LCP element on the site.
 * Measured on the LTX-2.3 detail hero: 350x350, 52 frames, 1,870 KB, painted
 * into a 640x360 box, LCP 16.7 s on Lighthouse mobile with 16.0 s of that in
 * RENDER delay - the bytes land at 1.9 s and the rest is decoding 52 frames on
 * a throttled CPU. The still costs 18.9 KB and one frame.
 *
 * So the hero paints the still, and the script below swaps the animation in
 * after `load`, once it is no longer competing with anything. Lazy cards are
 * untouched: they are off screen, so they are not the LCP element, and giving
 * them a second URL would just fetch the same picture twice.
 *
 * Only when there is no re-encoded copy, which for animated WebP is always
 * (they are deliberately absent from the manifest) - if one exists, `primarySrc`
 * is already our own right-sized still and there is nothing to improve.
 *
 * `heroPaintsAnimatedStill` is the same guard the page's `<link rel="preload">`
 * uses, and it is what keeps the two in step: the compare-slider and
 * hover-dissolve branches below are checked BEFORE the animated one and win
 * whenever there is a second thumbnail, in which case this still is never
 * rendered and must not be preloaded either.
 *
 * The animation URL travels in `data-animated-src` and the `onerror` handler
 * reads it from there rather than being built by interpolating the URL into a
 * quoted JS string. A thumbnail filename is upstream data; one apostrophe in it
 * would close that string and leave the rest as executable script.
 */
const heroStillSrc =
  isAnimated &&
  loading === 'eager' &&
  primarySrc === primaryOriginal &&
  heroPaintsAnimatedStill(thumbnails, variant)
    ? getStillImageUrl(primaryOriginal, HERO_STILL_WIDTH)
    : null;
const hasSecondImage = thumbnails.length > 1;
const isAudio = primaryThumb ? isAudioFile(primaryThumb) : false;
const isVideo = primaryThumb ? isVideoFile(primaryThumb) : false;
const isSecondaryVideo = secondaryThumb ? isVideoFile(secondaryThumb) : false;
// Posters resolve from the ORIGINAL url: our manifest is keyed by the upstream
// asset id, and primarySrc may already point at our bucket.
const videoPosterUrl = isVideo
  ? (hubMediaFor(primaryOriginal)?.poster ?? getVideoFrameUrl(primaryOriginal))
  : null;
const secondaryVideoPosterUrl = isSecondaryVideo
  ? (hubMediaFor(secondaryOriginal)?.poster ?? getVideoFrameUrl(secondaryOriginal))
  : null;
---

{
  !primaryThumb ? (
    <div
      class={`placeholder-thumb flex items-center justify-center bg-hub-surface border border-divider-subtle rounded-[var(--radius-banner)] ${className}`}
    >
      <div class="flex flex-col items-center gap-3 text-content/30">
        <svg
          class="w-12 h-12"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z"
          />
        </svg>
        <span class="text-sm">{title}</span>
      </div>
    </div>
  ) : isAudio ? (
    <div
      class={`audio-thumb flex flex-col items-center justify-center bg-hub-surface border border-divider-subtle rounded-[var(--radius-banner)] p-6 ${className}`}
    >
      <div class="flex flex-col items-center gap-4 w-full">
        <svg
          class="w-10 h-10 text-content-muted"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
          />
        </svg>
        <span class="text-sm text-content-muted">{title}</span>
        <audio controls preload="none" class="w-full max-w-[300px]">
          <source
            src={primarySrc}
            type={primaryThumb.endsWith('.mp3') ? 'audio/mpeg' : 'audio/webm'}
          />
        </audio>
      </div>
    </div>
  ) : isVideo ? (
    <div class={`video-thumb flex flex-col gap-2 ${className}`}>
      <div class="video-fallback-wrapper">
        <video
          src={primarySrc}
          poster={videoPosterUrl || undefined}
          class={mediaClass}
          autoplay
          controls
          loop
          muted
          playsinline
          preload="auto"
          data-video-fallback
        />
        {videoPosterUrl && (
          <img
            src={videoPosterUrl}
            alt={title}
            class={`${mediaClass} hidden`}
            data-video-fallback-img
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
      {secondaryThumb && isSecondaryVideo && (
        <div class="video-fallback-wrapper">
          <video
            src={secondarySrc}
            poster={secondaryVideoPosterUrl || undefined}
            class={mediaClass}
            controls
            loop
            muted
            playsinline
            preload="metadata"
            data-video-fallback
          />
          {secondaryVideoPosterUrl && (
            <img
              src={secondaryVideoPosterUrl}
              alt={`${title} - secondary`}
              class={`${mediaClass} hidden`}
              data-video-fallback-img
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      )}
      {secondaryThumb && !isSecondaryVideo && (
        <img
          src={secondarySrc}
          alt={`${title} - secondary`}
          class={mediaClass}
          loading="lazy"
          decoding="async"
          data-hide-on-error
        />
      )}
    </div>
  ) : variant === 'compareSlider' && hasSecondImage ? (
    <div class={`compare-slider relative overflow-hidden ${className}`} data-compare-slider>
      <img
        src={secondarySrc}
        alt={`${title} - After`}
        loading={loading}
        fetchpriority={fetchpriority}
        width="640"
        height="360"
        decoding="async"
        draggable="false"
        sizes={sizes}
        class={imgClass}
      />
      <div
        class="compare-overlay absolute inset-0 overflow-hidden"
        style="clip-path: inset(0 50% 0 0);"
      >
        <img
          src={primarySrc}
          alt={`${title} - Before`}
          loading={loading}
          width="640"
          height="360"
          decoding="async"
          draggable="false"
          sizes={sizes}
          class="w-full h-full object-cover"
        />
      </div>
      <div
        class="compare-handle absolute top-0 bottom-0 w-1 bg-white shadow-lg cursor-ew-resize"
        style="left: 50%;"
        role="slider"
        tabindex="0"
        aria-label="Comparison slider"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
      >
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 bg-white rounded-full shadow-lg flex items-center justify-center">
          <svg
            class="w-4 h-4 text-gray-600"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M8 12H16M8 12L11 9M8 12L11 15M16 12L13 9M16 12L13 15" />
          </svg>
        </div>
      </div>
    </div>
  ) : variant === 'hoverDissolve' && hasSecondImage ? (
    <div class={`hover-dissolve group relative overflow-hidden ${className}`}>
      <img
        src={primarySrc}
        alt={`${title} - State 1`}
        loading={loading}
        fetchpriority={fetchpriority}
        width="640"
        height="360"
        decoding="async"
        draggable="false"
        sizes={sizes}
        class={`${imgClass} transition-opacity duration-500`}
      />
      <img
        src={secondarySrc}
        alt={`${title} - State 2`}
        loading={loading}
        width="640"
        height="360"
        decoding="async"
        draggable="false"
        sizes={sizes}
        class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      />
    </div>
  ) : isAnimated ? (
    <div class={`animated-thumb group relative overflow-hidden ${className}`}>
      <img
        src={heroStillSrc ?? primarySrc}
        data-animated-src={heroStillSrc ? primarySrc : undefined}
        alt={title}
        loading={loading}
        fetchpriority={fetchpriority}
        width="640"
        height="360"
        decoding="async"
        draggable="false"
        sizes={sizes}
        class={imgClass}
        onerror={
          heroStillSrc
            ? 'this.onerror=null;const s=this.dataset.animatedSrc;delete this.dataset.animatedSrc;if(s)this.src=s'
            : undefined
        }
      />
    </div>
  ) : variant === 'zoomHover' ? (
    <div class={`zoom-hover group relative overflow-hidden ${className}`}>
      <img
        src={primarySrc}
        alt={title}
        loading={loading}
        fetchpriority={fetchpriority}
        width="640"
        height="360"
        decoding="async"
        draggable="false"
        sizes={sizes}
        class={`${imgClass} transition-transform duration-500 group-hover:scale-125`}
      />
    </div>
  ) : (
    <div class={`default-thumb group relative overflow-hidden ${className}`}>
      <img
        src={primarySrc}
        alt={title}
        loading={loading}
        fetchpriority={fetchpriority}
        width="640"
        height="360"
        decoding="async"
        draggable="false"
        sizes={sizes}
        class={`${imgClass} transition-transform duration-300 group-hover:scale-105`}
      />
    </div>
  )
}

<script>
  /**
   * Swap the animation in behind the hero still, once it costs nothing.
   *
   * The hero renders a one-frame still so it is not the LCP element paying for
   * a 52-frame, 1.9 MB decode. The animation is still the intended design, so
   * it is fetched after `load`, when it is no longer competing with the first
   * paint. Assigning `src` on an already-painted <img> swaps the picture with
   * no reflow: the element keeps its box and its declared dimensions.
   *
   * Honours `prefers-reduced-motion`, which also means those readers never pay
   * for the animated file at all - the same gating the video work in this change
   * applies everywhere else.
   */
  /**
   * Wide viewports only.
   *
   * Measured: swapping on mobile just moves the cost rather than removing it.
   * The still paints at 16 KB and render delay drops from 16.0 s to 0.35 s, but
   * assigning the 1.9 MB original repaints the same element, so LCP follows the
   * swap and comes back as 9.2 s of LOAD time instead. On a 412 px screen that
   * is 1.9 MB to animate a 350x350 source that is being upscaled anyway.
   *
   * Desktop already scores 99-100 and loads the original today, so it keeps the
   * animation and is no worse than before. This is the one deliberate product
   * change in the fix: on phones the detail hero is a still. Delete this check
   * to restore animation everywhere.
   */
  const WIDE_VIEWPORT = 1024;

  function loadHeroAnimations() {
    if (window.innerWidth < WIDE_VIEWPORT) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLImageElement>('img[data-animated-src]').forEach((img) => {
      const src = img.dataset.animatedSrc;
      if (!src) return;
      // Decode off the main thread first, so the swap cannot drop a frame.
      const full = new Image();
      full.decoding = 'async';
      full.onload = () => {
        img.src = src;
        delete img.dataset.animatedSrc;
      };
      full.src = src;
    });
  }

  if (document.readyState === 'complete') loadHeroAnimations();
  else window.addEventListener('load', loadHeroAnimations, { once: true });

  import '../scripts/compare-slider';

  // Video fallback: show poster image if video fails to load, stalls, or autoplay is suppressed
  document.querySelectorAll<HTMLVideoElement>('[data-video-fallback]').forEach((video) => {
    const wrapper = video.closest('.video-fallback-wrapper');
    const fallbackImg = wrapper?.querySelector<HTMLImageElement>('[data-video-fallback-img]');
    if (!fallbackImg) return;

    let fallbackShown = false;

    function showFallback() {
      if (fallbackShown) return;
      fallbackShown = true;
      video.classList.add('hidden');
      fallbackImg!.classList.remove('hidden');
    }

    video.addEventListener('error', showFallback);
    video.addEventListener('stalled', showFallback);

    // Detect autoplay suppression (low-power mode, data-saver) — if the video
    // hasn't started playing after 3s, show the fallback image instead.
    setTimeout(() => {
      if (video.paused && video.readyState < 3) {
        showFallback();
      }
    }, 3000);
  });

  // Hide images that fail to load (e.g. CDN 404) so we don't render broken icons.
  document.querySelectorAll<HTMLImageElement>('[data-hide-on-error]').forEach((img) => {
    img.addEventListener('error', () => img.classList.add('hidden'));
  });
</script>

<style>
  img {
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
  }
</style>
