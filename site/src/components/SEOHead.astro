---
import HreflangTags from './HreflangTags.astro';
import { OG_LOCALES, type Locale } from '../i18n/config';
import { clusterLocales, getLocaleFromPath, unlocalizePath } from '../i18n/utils';
import { absoluteUrl, SITE_NAME } from '../config/site';
import { serializeJsonLdForScript } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  /** Social-card description (OG/Twitter). Defaults to `description` when omitted. */
  ogDescription?: string;
  ogType?: 'website' | 'article';
  structuredData?: object;
  /** Base path for hreflang tags (without locale prefix) */
  hreflangBasePath?: string;
  /** Whether localized variants exist; false emits x-default only (no per-locale alternates). */
  hreflangLocalized?: boolean;
  /** Explicit per-page alternate locales; overrides hreflangLocalized. */
  hreflangLocales?: readonly Locale[];
  /** Emit robots noindex (keeps follow) for thin/unverified pages. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/brand/og-default-v3.png',
  ogDescription = description,
  ogType = 'website',
  structuredData,
  hreflangBasePath,
  hreflangLocalized = true,
  hreflangLocales,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;

const fullCanonicalUrl = canonicalUrl
  ? canonicalUrl
  : absoluteUrl(`${pathname}${pathname.endsWith('/') ? '' : '/'}`);
const fullOgImage = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);

const OG_IMAGE_MIME: Record<string, string> = {
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  png: 'image/png',
  webp: 'image/webp',
  avif: 'image/avif',
  gif: 'image/gif',
};
const ogImageExt = ogImage.split('?')[0].split('.').pop()?.toLowerCase() ?? '';
const ogImageType = OG_IMAGE_MIME[ogImageExt] ?? 'image/png';

const computedHreflangBasePath = hreflangBasePath ?? unlocalizePath(pathname);

// Social platforms read og:locale to decide which audience a shared link suits;
// without it every localized page presents itself as language-neutral. Built from
// the same cluster the hreflang tags use so the two cannot contradict each other.
const currentLocale = getLocaleFromPath(pathname);
const ogAlternateLocales: readonly Locale[] = clusterLocales(
  hreflangLocalized,
  hreflangLocales
).filter((locale) => locale !== currentLocale);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}
<link rel="canonical" href={fullCanonicalUrl} />

{/* Hreflang tags for international SEO */}
<HreflangTags
  basePath={computedHreflangBasePath}
  localized={hreflangLocalized}
  locales={hreflangLocales}
/>

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={OG_LOCALES[currentLocale]} />
{
  ogAlternateLocales.map((locale) => (
    <meta property="og:locale:alternate" content={OG_LOCALES[locale]} />
  ))
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={title} />

<!-- Favicon -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!--
  Google Fonts: Inter, loaded off the critical path.

  As a plain `rel="stylesheet"` this was the single largest render-blocking
  resource on mobile: Lighthouse attributed 1,204 ms to it on the use-case
  detail page and 1,210 ms on the workflow detail page, for 1.2 KB of CSS. It
  held up FIRST PAINT on a third-party round trip, which is why FCP and LCP came
  out identical at 3.7 s on the use-case page - nothing could paint until Google
  answered.

  Preloading it as a stylesheet and promoting it in `onload` keeps the same
  font, the same weights and the same `display=swap`, and gives up nothing: the
  font FILE was always going to arrive after first paint and swap in, because
  that is what `display=swap` asks for. All this changes is that the text now
  paints in the fallback face immediately instead of waiting on the round trip.
  The preconnects stay, so the promoted stylesheet resolves without a fresh
  DNS/TCP/TLS handshake.

  The pattern is a `preload` for priority plus a `media="print"` stylesheet that
  is promoted in `onload`. The media attribute is what does the work: a
  stylesheet whose media query does not match is non-render-blocking BY SPEC,
  where `rel="preload"` promoted to `rel="stylesheet"` can still land before
  first paint and block anyway. The preload is what stops the print sheet being
  fetched at low priority.

  The further step, if the swap window is judged too visible, is self-hosting
  Inter next to PP Formula in `public/fonts/` - identical rendering, and it
  drops two third-party origins rather than just moving them off the critical
  path. Inter v20 is a variable font, so that is 7 woff2 files (one per unicode
  subset) covering all three weights, not 21. Deliberately not bundled here: it
  touches every locale, and dropping a subset is an i18n decision, not a perf
  one.
-->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
  media="print"
  onload="this.onload=null;this.media='all'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</noscript>

{
  structuredData && (
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLdForScript(structuredData)}
    />
  )
}
