---
import { getCollection } from 'astro:content';
import { getLocaleFromPath } from '../../i18n/utils';
import HeaderMain from './nav/HeaderMain.vue';
import SearchPopover from './SearchPopover.vue';
import { getProfileCache, getCreatorsList, loadSerializedTemplates } from '../../lib/hub-api';
import { buildDiscoveryData, type DiscoveryData } from '../../lib/search-discovery';
import { fetchGitHubStars, formatStarCount } from '../../lib/github';

interface Props {
  /** Render the search bar in the header. Index pages set false (render it in-body). */
  showSearch?: boolean;
  /** Pin the header to the top. Defaults to showSearch so existing callers are unchanged. */
  sticky?: boolean;
}

const { showSearch = true, sticky = showSearch } = Astro.props;

const rawStars = await fetchGitHubStars('Comfy-Org', 'ComfyUI');
const githubStars = rawStars ? formatStarCount(rawStars) : '';

const locale = getLocaleFromPath(Astro.url.pathname);

// Precompute the small discovery slices (popular, creators, facets) only when
// the header renders the search bar. The full catalog stays server-side and is
// lazy-loaded by the island from grid.json when a filter is applied.
let discovery: DiscoveryData | null = null;
if (showSearch) {
  const [searchTemplates, profiles] = await Promise.all([
    loadSerializedTemplates(() => getCollection('templates')),
    getProfileCache(),
  ]);
  discovery = buildDiscoveryData(searchTemplates, getCreatorsList(profiles));
}
---

<header class:list={['w-full bg-page', sticky && 'sticky top-0 z-50']}>
  <div class="max-w-400 mx-auto px-6 lg:px-[clamp(0.25rem,4vw,5rem)]">
    <div class="pt-4 lg:pt-8 pb-6 lg:pb-8">
      <HeaderMain client:load locale={locale} githubStars={githubStars} />
    </div>

    {
      showSearch && discovery && (
        <div class="w-full min-w-0 pb-6 lg:pb-8">
          <SearchPopover
            client:load
            popular={discovery.popular}
            creators={discovery.creators}
            facets={discovery.facets}
            totalCount={discovery.totalCount}
            locale={locale}
          />
        </div>
      )
    }
  </div>
</header>
