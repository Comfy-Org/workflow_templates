---
/**
 * Card thumbnail with a Comfy-mark fallback. Renders the image plus a hidden
 * placeholder (the Comfy "C" centered on the card surface); if the image fails to
 * load, an inline onerror hides the broken image and reveals the placeholder, so a
 * 404 thumbnail never shows the browser's broken-image glyph. Shared by every
 * landing-page card so the fallback looks identical everywhere.
 *
 * Pass `class` to keep each call site's image styling (object-cover, scale-on-hover,
 * absolute fill, etc.); the placeholder always fills its positioned parent.
 */
import { COMFY_GLYPH } from './comfy-glyph';
import { isVideoFile } from '../../lib/media-utils';
import { hubImageFor, hubMediaFor } from '../../lib/hub-media';

interface Props {
  src?: string | null;
  alt: string;
  class?: string;
}

const { src, alt, class: imgClass } = Astro.props;
const isVideo = Boolean(src && isVideoFile(src));

// Prefer our re-encoded copy of the asset. Shared by every landing-page card,
// so this one line covers all of them; anything without a generated copy keeps
// its original URL untouched.
const resolvedSrc = src
  ? (isVideo ? hubMediaFor(src)?.video : hubImageFor(src)) ?? src
  : src;
const posterSrc = src && isVideo ? hubMediaFor(src)?.poster : undefined;
---

{
  src &&
    (isVideo ? (
      <video
        src={resolvedSrc}
        poster={posterSrc}
        class={imgClass}
        preload="none"
        muted
        loop
        playsinline
        data-gated-video
        aria-label={alt}
        onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
      />
    ) : (
      <img
        src={resolvedSrc}
        alt={alt}
        class={imgClass}
        loading="lazy"
        decoding="async"
        onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
      />
    ))
}
<span
  hidden={Boolean(src)}
  class="absolute inset-0 flex items-center justify-center bg-hub-surface"
  aria-hidden="true"
>
  <svg class="h-1/3 w-1/3 text-content/15" viewBox="0 0 520 520" fill="currentColor">
    <path d={COMFY_GLYPH}></path>
  </svg>
</span>

<script>
  /**
   * Play only the card thumbnails the reader can see.
   *
   * These carried `autoplay`, which silently overrides `preload`, so every card
   * on a landing page downloaded its full clip on first paint: eight of them,
   * 11.49 MB, on /workflows/use-cases/ alone. This is the same gating the hub
   * cards use in HubWorkflowCard.vue, written for Astro because these cards
   * ship no framework runtime.
   *
   * Astro bundles this script once per page however many thumbnails render, so
   * a single observer covers all of them.
   */
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-gated-video]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if ('IntersectionObserver' in window) {
    // Deliberately never unobserved, so a card scrolled past and returned to
    // plays again rather than staying frozen on its poster.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reducedMotion.matches) {
            // Rejects when the browser declines playback. The poster stays
            // visible, which is what the reader saw before playback started.
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px' }
    );
    videos.forEach((video) => observer.observe(video));
  } else {
    // No observer support: fall back to today's behaviour rather than leaving
    // a reader looking at posters that never move.
    videos.forEach((video) => video.play().catch(() => {}));
  }
</script>
