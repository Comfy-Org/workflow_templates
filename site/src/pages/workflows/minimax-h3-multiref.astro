---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HubNavbar from '@/components/hub/HubNavbar.astro';
import SiteFooter from '@/components/hub/SiteFooter.astro';
import Breadcrumbs from '@/components/template-detail/Breadcrumbs.astro';
import MiniMaxH3Demo from '@/components/demos/MiniMaxH3Demo.vue';
import graph from '@/lib/demos/mmh3/workflow-api.json';
import {
  KEYFRAMES,
  INPUT_NODES,
  AGENT_PROMPT_URL,
  EXAMPLE_VIDEO_URL,
  exampleKeyframeUrl,
} from '@/lib/demos/mmh3/config';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { isExperimentEnabled } from '@/config/experimentFlags';
import { getCloudLandingUrl } from '@/lib/urls';
import { localizeUrl } from '@/i18n/utils';

type ApiNode = { class_type: string; inputs: Record<string, unknown> };
const nodes = graph as unknown as Record<string, ApiNode>;
const locale = DEFAULT_LOCALE;

/**
 * Decided at build time so the two branches differ in the emitted HTML, not in
 * what client JS chooses to mount. A crawler and a visitor are served byte-identical
 * markup either way, which is the only version of this gate that is safe for SEO.
 */
const demoEnabled = isExperimentEnabled('minimaxH3Demo');

/** Seed the prompt editor with the text the workflow ships with. */
const defaultPrompt = String(nodes[INPUT_NODES.prompt.nodeId]?.inputs?.prompt ?? '');

const exampleKeyframes = KEYFRAMES.map((slot) => exampleKeyframeUrl(slot.index));
const exampleVideo = EXAMPLE_VIDEO_URL;
const agentPromptUrl = AGENT_PROMPT_URL;

const pageTitle = 'MiniMax H3 - Motion Context';

/**
 * The heading and title promise a runner only when there is one. With the demo
 * off, "Live workflow / run the workflow" is contradicted by body copy three
 * sections below saying the runner is turned off — the first thing a visitor
 * reads should not be the one thing the page cannot do.
 */
const eyebrow = demoEnabled ? 'Live workflow' : 'Workflow preview';
const titleSuffix = demoEnabled ? ' — run the workflow' : ' — workflow preview';
const description =
  'Guide one continuous shot with three reference images pinned to exact moments, and get video with matching audio.';

/**
 * Held noindex in BOTH states, deliberately, and NOT wired to the experiment flag.
 *
 * The flag moves whenever the demo's backend goes down — a health check opens
 * the flag-off PR, a human merges it and the next build ships it — so tying
 * indexability to it would let this URL's crawlability flap with backend
 * uptime, which teaches crawlers it is unreliable and is strictly worse for the
 * ranking this page was built to capture. Ranking gets earned by promoting a
 * proven page in one reviewed commit. See docs/shipping-experiments-policy.md.
 */
const noindex = true;
---

<BaseLayout
  title={`${pageTitle}${titleSuffix}`}
  {description}
  theme="dark"
  {noindex}
  hideDefaultFooter
>
  <HubNavbar />

  <article class="template-detail-page bg-page min-h-screen text-content scroll-smooth">
    <div class="max-w-400 mx-auto px-6 lg:px-[clamp(0.25rem,4vw,5rem)] pt-4 lg:pt-8 pb-32">
      <Breadcrumbs locale={locale} title={pageTitle} class="mb-6 lg:mb-8" />

      <header class="mb-12 max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand">{eyebrow}</p>
        <h1
          class="mt-4 font-display text-4xl font-light leading-none tracking-[-0.03em] text-content sm:text-5xl lg:text-6xl"
        >
          {pageTitle}
        </h1>
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-content-secondary sm:text-lg">
          {description}
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            ['Video', 'Audio', 'Image to video', '3 references'].map((tag) => (
              <span class="rounded-full bg-hub-surface px-4 py-2 text-sm text-content-secondary">
                {tag}
              </span>
            ))
          }
        </div>
      </header>

      {
        demoEnabled ? (
          <MiniMaxH3Demo
            client:load
            defaultPrompt={defaultPrompt}
            exampleKeyframes={exampleKeyframes}
            exampleVideo={exampleVideo}
            agentPromptUrl={agentPromptUrl}
          />
        ) : (
          /*
           * Static stand-in, shaped like a normal template detail page: preview
           * media, what the workflow does, and a route onward. It ships zero
           * client JS and never calls the demo API, so a down backend cannot
           * produce an error state here.
           *
           * It deliberately does not say "try again later" and stop there — a
           * page whose only outcome is a dead end is the failure mode this whole
           * gate exists to avoid, so both CTAs go somewhere that actually works.
           */
          <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(380px,30rem)] lg:items-start">
            <div class="media-frame overflow-hidden rounded-4xl bg-black">
              <video
                src={exampleVideo}
                poster={exampleKeyframes[0]}
                controls
                muted
                loop
                playsinline
                preload="metadata"
                class="h-full w-full object-cover"
              />
            </div>

            <div class="flex min-w-0 flex-col gap-5 rounded-4xl bg-hub-surface p-6 sm:p-8">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-brand">
                  Preview
                </span>
                <h2 class="mt-3 text-2xl font-normal text-content sm:text-3xl">
                  Three references, one continuous shot
                </h2>
                <p class="mt-4 text-base leading-relaxed text-content-secondary">
                  The clip above was generated by this workflow from the three reference frames
                  below, pinned to the first, middle and final frame. The in-browser runner is
                  turned off right now — MiniMax H3 workflows run today in Comfy Cloud.
                </p>
              </div>

              <div class="flex flex-wrap gap-3">
                {exampleKeyframes.map((src, i) => (
                  <img
                    src={src}
                    alt={`Reference ${i + 1} of 3 used to generate the preview clip`}
                    width="96"
                    height="96"
                    loading="lazy"
                    decoding="async"
                    class="h-24 w-24 rounded-2xl object-cover"
                  />
                ))}
              </div>

              <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                {/*
                  "Open", not "Run this workflow": getCloudLandingUrl carries no
                  workflow identifier, so this lands on the Cloud home page. This
                  page is bespoke rather than a content-collection entry, so it
                  has no shareId to hand getCloudCtaUrl. Promising a one-click run
                  the link cannot deliver would rebuild, in the fallback, the dead
                  end the fallback exists to replace.

                  `run-cloud-btn` is what PostHogAnalytics delegates on; with no
                  `data-template` it reports as a signup CTA at `mmh3_fallback`.
                  The class is the tracking hook, not styling — dropping it makes
                  the click silent.
                */}
                <a
                  href={getCloudLandingUrl('minimax_h3_multiref_fallback')}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-location="mmh3_fallback"
                  class="run-cloud-btn inline-flex h-10 shrink-0 items-center justify-center whitespace-nowrap rounded-2xl bg-brand px-6 text-sm font-semibold uppercase tracking-wider text-page transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-page"
                >
                  Open Comfy Cloud
                </a>
                <a
                  href={localizeUrl('/workflows/', locale)}
                  class="inline-flex h-10 shrink-0 items-center justify-center whitespace-nowrap rounded-2xl bg-white/4 px-6 text-sm font-semibold uppercase tracking-wider text-content-secondary transition-colors hover:text-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-page"
                >
                  Browse all workflows
                </a>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </article>

  <Fragment slot="footer">
    <SiteFooter />
  </Fragment>
</BaseLayout>
