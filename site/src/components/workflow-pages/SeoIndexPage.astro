---
/** Shared shell for the SEO index pages (models, use-cases): navbar, page header,
 *  the IndexCard grid, and CollectionPage + breadcrumb JSON-LD. Each route computes
 *  its cards/heading/description/basePath and delegates the layout here. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubNavbar from '../hub/HubNavbar.astro';
import SiteFooter from '../hub/SiteFooter.astro';
import IndexPageHeader from './IndexPageHeader.astro';
import IndexCard from './cards/IndexCard.astro';
import type { SeoPageCard } from '../../lib/workflow-pages/schema';
import type { Locale } from '../../i18n/config';
import { localizeUrl } from '../../i18n/utils';
import { absoluteUrl, SITE_NAME } from '../../config/site';
import {
  buildSeoGraphJsonLd,
  type StructuredDataAbout,
  type StructuredDataMention,
} from '../../lib/structured-data';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** Root-relative index path with NO locale prefix — `localizeUrl` below prepends
   *  the locale, so a prefixed value would double it into `/ja/ja/…`. */
  basePath: string;
  heading: string;
  description: string;
  cards: SeoPageCard[];
  /** Optional name for the ItemList entity (e.g. "Use Case Categories") */
  itemListName?: string;
  about?: StructuredDataAbout;
  mentions?: StructuredDataMention;
}

const { locale, basePath, heading, description, cards, itemListName, about, mentions } =
  Astro.props;

const canonicalUrl = absoluteUrl(localizeUrl(basePath, locale));
const name = `${heading} | ${SITE_NAME}`;

const items = cards.map((card) => ({
  name: card.title,
  url: absoluteUrl(card.href),
  itemType: card.itemType || 'CollectionPage',
  description: `${card.count} ${t(card.count === 1 ? 'template.countOne' : 'template.count', locale)}`,
}));

const structuredData = buildSeoGraphJsonLd({
  name: heading,
  description,
  url: canonicalUrl,
  inLanguage: locale,
  breadcrumbItems: [
    { name: t('breadcrumb.home', locale), item: absoluteUrl(localizeUrl('/', locale)) },
    {
      name: t('breadcrumb.workflows', locale),
      item: absoluteUrl(localizeUrl('/workflows/', locale)),
    },
    { name: heading },
  ],
  items,
  itemListName: itemListName || heading,
  about,
  mentions,
});
---

<BaseLayout
  title={name}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage="/workflows/og-default.png"
  structuredData={structuredData}
  locale={locale}
  hreflangBasePath={basePath}
  hreflangLocalized={false}
  theme="dark"
  hideDefaultFooter
>
  <HubNavbar />
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-16 pt-4 lg:pt-6 pb-12">
    <IndexPageHeader locale={locale} heading={heading} description={description} />

    <IndexCard cards={cards} locale={locale} />
  </div>

  <Fragment slot="footer">
    <SiteFooter />
  </Fragment>
</BaseLayout>
