---
/**
 * Card thumbnail with a Comfy-mark fallback. Renders the image plus a hidden
 * placeholder (the Comfy "C" centered on the card surface); if the image fails to
 * load, an inline onerror hides the broken image and reveals the placeholder, so a
 * 404 thumbnail never shows the browser's broken-image glyph. Shared by every
 * landing-page card so the fallback looks identical everywhere.
 *
 * Pass `class` to keep each call site's image styling (object-cover, scale-on-hover,
 * absolute fill, etc.); the placeholder always fills its positioned parent.
 */
import { COMFY_GLYPH } from './comfy-glyph';
import { isVideoFile } from '../../lib/media-utils';
import { hubImageFor, hubMediaFor } from '../../lib/hub-media';
import { getVideoFrameUrl } from '../../lib/video-thumbnail';

interface Props {
  src?: string | null;
  alt: string;
  class?: string;
}

const { src, alt, class: imgClass } = Astro.props;
const isVideo = Boolean(src && isVideoFile(src));

const resolvedSrc = src ? ((isVideo ? hubMediaFor(src)?.video : hubImageFor(src)) ?? src) : src;
const posterSrc =
  src && isVideo ? (hubMediaFor(src)?.poster ?? getVideoFrameUrl(src) ?? undefined) : undefined;
---

{
  src &&
    (isVideo ? (
      <video
        src={resolvedSrc}
        poster={posterSrc}
        class={imgClass}
        preload="none"
        muted
        loop
        playsinline
        data-gated-video
        aria-label={alt}
        onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
      />
    ) : (
      <img
        src={resolvedSrc}
        alt={alt}
        class={imgClass}
        loading="lazy"
        decoding="async"
        onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
      />
    ))
}
<span
  hidden={Boolean(src)}
  class="absolute inset-0 flex items-center justify-center bg-hub-surface"
  aria-hidden="true"
>
  <svg class="h-1/3 w-1/3 text-content/15" viewBox="0 0 520 520" fill="currentColor">
    <path d={COMFY_GLYPH}></path>
  </svg>
</span>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-gated-video]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reducedMotion.matches) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px' }
    );
    videos.forEach((video) => observer.observe(video));
  } else if (!reducedMotion.matches) {
    videos.forEach((video) => video.play().catch(() => {}));
  }
</script>
