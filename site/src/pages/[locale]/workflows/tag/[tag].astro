---
/**
 * Localized tag page (on-demand rendered)
 * Serves pages like /zh/workflows/tag/portrait/, /ja/workflows/tag/upscale/, etc.
 */
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HubNavbar from '../../../../components/hub/HubNavbar.astro';
import SiteFooter from '../../../../components/hub/SiteFooter.astro';
import WorkflowGrid from '../../../../components/hub/WorkflowGrid.vue';
import BackButton from '../../../../components/BackButton.astro';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../../../../i18n/config';
import { t } from '../../../../i18n/ui';
import { tagSlug, tagDisplayName } from '../../../../lib/tag-aliases';
import { absoluteUrl, SITE_NAME } from '../../../../config/site';
import { badgeVariants } from '../../../../components/ui/badge';
import { loadSerializedTemplates } from '../../../../lib/hub-api';
import { buildToolbarLabels } from '../../../../lib/toolbar';
import { serializeJsonLdForScript, buildWorkflowBreadcrumb } from '../../../../lib/structured-data';
import { listingIndexing } from '../../../../lib/i18n/listing-indexing';
import { localizeCards } from '../../../../lib/i18n/localize-cards';

const { locale, tag } = Astro.params;

if (Astro.url.pathname.endsWith('.json') || Astro.url.pathname.endsWith('.json/')) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

// Validate locale
if (!locale || !LOCALES.includes(locale as Locale) || locale === DEFAULT_LOCALE) {
  return Astro.redirect(`/workflows/tag/${tag || ''}/`);
}

const typedLocale = locale as Locale;

// Cards come from the hub index, which is English only. Resolve the same text
// the detail page will show, so a localized listing is not a translated page
// sitting above a grid of English cards.
const allTemplates = localizeCards(
  await loadSerializedTemplates(() => getCollection('templates')),
  typedLocale
);

// Find templates matching this tag slug
const matchingTemplates = allTemplates.filter((tmpl) =>
  tmpl.tags.some((t: string) => tagSlug(t) === tag)
);

if (matchingTemplates.length === 0) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

// Get display name from the first matching tag
const firstMatchingTag =
  matchingTemplates[0].tags?.find((t: string) => tagSlug(t) === tag) || tag || '';
const tagName = tagDisplayName(firstMatchingTag);

const basePath = `/workflows/tag/${tag}/`;
// Gated until this locale completes native review — see listing-indexing.
const indexing = listingIndexing(basePath, typedLocale);
const canonicalUrl = absoluteUrl(indexing.canonicalPath);

const title = t('tag.metaTitle', typedLocale)
  .replace('{tag}', tagName)
  .replace('{site}', SITE_NAME)
  .replace('{workflows}', t('nav.templates', typedLocale));
// Localized (falls back to English until the CI locale step translates the new
// key). These tag pages are already self-canonical, so this is a quick CTR win.
const description = t('tag.metaDescription', typedLocale)
  .replace('{count}', String(matchingTemplates.length))
  .replace('{tag}', tagName);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${tagName} ${SITE_NAME}`,
  description,
  url: canonicalUrl,
  inLanguage: locale,
};

const breadcrumbStructuredData = buildWorkflowBreadcrumb(typedLocale, { name: tagName });

// matchingTemplates are already SerializedTemplate[] with profile data
const serialized = matchingTemplates;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage="/brand/og-default-v3.png"
  structuredData={structuredData}
  locale={typedLocale}
  hreflangBasePath={basePath}
  hreflangLocales={indexing.hreflangLocales}
  noindex={indexing.noindex}
  theme="dark"
  hideDefaultFooter
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLdForScript(breadcrumbStructuredData)}
  />

  <HubNavbar />
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-16 py-12">
    <!-- Back -->
    <nav class="mb-8">
      <BackButton locale={typedLocale} />
    </nav>

    <!-- Header -->
    <div class="mb-12 text-center">
      <span class={badgeVariants({ variant: 'hub-pill' })}>Tag</span>
      <h1 class="text-3xl font-bold text-content mt-3">
        {tagName}
      </h1>
      <p class="text-hub-muted text-base mt-2">
        {matchingTemplates.length} workflow{matchingTemplates.length !== 1 ? 's' : ''}
      </p>
    </div>

    <!-- Interactive Grid -->
    <WorkflowGrid
      client:load
      templates={serialized}
      locale={typedLocale}
      toolbarLabels={buildToolbarLabels(typedLocale)}
      gridClass="grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
    />
  </div>

  <Fragment slot="footer">
    <SiteFooter />
  </Fragment>
</BaseLayout>
